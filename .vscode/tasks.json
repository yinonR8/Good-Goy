{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev (fast, no PWA)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Preview PWA (build + start)",
      "type": "shell",
      "command": "npm run build; if ($?) { npm run start }",
      "isBackground": false,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "group": "build",
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        }
      }
    }
  ]
}
